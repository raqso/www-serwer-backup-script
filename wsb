        else
          printf "%s\n" "--version requires an argument: --version TAG" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
