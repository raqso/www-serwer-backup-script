normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

# Download and checksum helpers for wsb install. ${deps[http_client]} (curl or wget) and
# ${deps[sha256]} (sha256sum or shasum) are set by bashly from the install dependencies.
# shellcheck disable=SC2154 # deps is set by the bashly dependency check

# download <url> <file>: fails on HTTP errors and leaves no partial file behind.
download() {
  local rc=0
  if [ "${deps[http_client]##*/}" = curl ]; then
    "${deps[http_client]}" -fsSL -o "$2" "$1" || rc=$?
  else
    "${deps[http_client]}" -q -O "$2" "$1" || rc=$?
  fi
  [ "$rc" = 0 ] || rm -f "$2"
  return "$rc"
}

# latest_github_tag <owner/repo>: tag of the latest release, taken from the redirect of
# https://github.com/<owner/repo>/releases/latest, so the GitHub API (and its rate limit) is
# not used. Prints nothing if there is no redirect.
latest_github_tag() {
  local url="https://github.com/$1/releases/latest"
  if [ "${deps[http_client]##*/}" = curl ]; then
    "${deps[http_client]}" -sI "$url" || true
  else
    # wget prints the headers to stderr and exits non-zero because it may not follow the redirect.
    "${deps[http_client]}" -q -S --max-redirect=0 -O /dev/null "$url" 2>&1 || true
  fi | tag_from_location
}

# tag_from_location: reads HTTP response headers on stdin and prints the release tag the
# Location header points to (.../releases/tag/<tag>).
tag_from_location() {
  awk 'tolower($1) == "location:" { print $2 }' | tr -d '\r' | sed -n 's|.*/releases/tag/||p'
}

# sums_entry <sums file> <file name>: the SHA-256 listed for that file name. Lines that are
# not "<hash>  <name>" (or "<hash> *<name>"), like a PGP signature around them, are ignored.
sums_entry() {
  awk -v f="$2" '($2 == f || $2 == "*" f) && length($1) == 64 { print $1; exit }' "$1"
}

# verify_sha256 <file> <sums file>: fails unless the SHA-256 of the file matches the entry
# for its name in the sums file.
verify_sha256() {
  local name want got
  name=${1##*/}
  want=$(sums_entry "$2" "$name")
  if [ -z "$want" ]; then
    echo "Error: $name is not listed in the checksum file." >&2
    return 1
  fi
  if [ "${deps[sha256]##*/}" = sha256sum ]; then
    got=$("${deps[sha256]}" "$1")
  else
    got=$("${deps[sha256]}" -a 256 "$1")
  fi
  got=${got%% *}
  if [ "$got" != "$want" ]; then
    echo "Error: checksum mismatch for $name (expected $want, got $got)." >&2
    return 1
  fi
}

wsb_backup_command() {

  # wsb backup [-v|--verbose]
  # Without -v a successful run prints nothing (cron sends no mail); the full output
  # of every run is kept in logs/. Failures print an ERROR and the end of the log to stderr.

  VERBOSE=false
  # shellcheck disable=SC2154 # args is set by the bashly parser
  [ -n "${args[--verbose]:-}" ] && VERBOSE=true
  LOG_FILE=""
  # Bashly indents this file inside a function, which would also indent the continuation
  # lines of a multi-line string literal, so multi-line messages use ${nl} instead.
  nl=$'\n'

  function log() {
    [ -n "$LOG_FILE" ] && echo -e "${1}" >>"$LOG_FILE"
    if [ "$VERBOSE" = true ]; then
      echo -e "${1}"
    fi
  }

  # Errors always go to stderr (cron mails them), regardless of --verbose.
  function die() {
    [ -n "$LOG_FILE" ] && echo "ERROR: ${1}" >>"$LOG_FILE"
    echo "ERROR: ${1}" >&2
    exit 1
  }

  # Runs a command with its output appended to the log (and shown on the terminal with -v).
  function run() {
    if [ "$VERBOSE" = true ]; then
      "$@" 2>&1 | tee -a "$LOG_FILE"
      return "${PIPESTATUS[0]}"
    fi
    "$@" >>"$LOG_FILE" 2>&1
  }

  cd "$(dirname "$0")" || exit 1

  # Logs and the lock may contain paths and hostnames: keep them private to this user.
  umask 077
  mkdir -p logs || exit 1

  # One backup at a time: a second run (cron or manual) must not touch the repositories
  # while restic prune or 'rclone sync' of the first one is still working.
  # flock is released by the kernel when the run (and every child it started) ends, so a
  # killed run never leaves a stale lock. Without flock, fall back to an atomic mkdir.
  if command -v flock >/dev/null 2>&1; then
    exec 9>>backup.lock || exit 1
    flock -n 9 || die "Another backup is already running (lock held on $PWD/backup.lock)."
    # Set only once the lock is ours, so a rejected second run leaves the first one's files alone.
    trap 'rm -f mysqldump.cnf' EXIT
  else
    # ponytail: a killed run leaves the directory behind; it is reported, not removed automatically.
    mkdir backup.lock.d 2>/dev/null || die "Another backup is already running (lock directory $PWD/backup.lock.d exists).${nl}If no backup is running (e.g. a previous run was killed), remove that directory."
    trap 'rm -f mysqldump.cnf; rmdir backup.lock.d' EXIT
  fi

  # The PID keeps the names of two runs started in the same second apart.
  LOG_FILE="logs/backup-$(date +%Y%m%d-%H%M%S)-$$.log"
  : >"$LOG_FILE" || exit 1
  find logs -name 'backup-*.log' -mtime +30 -delete

  if [ -f config.conf ]; then
    # shellcheck source=../config.conf.example
    . ./config.conf
  else
    die "No configuration file! Copy config.conf.example to config.conf and fill it in."
  fi

  for var in DIRECTORY_TO_BACKUP LOCAL_BACKUPS_PATH RCLONE_REMOTE_NAME DB_NAME DB_USER; do
    [ -n "${!var}" ] || die "$var is not set in config.conf."
  done

  [ -d "$DIRECTORY_TO_BACKUP" ] || die "DIRECTORY_TO_BACKUP does not exist: $DIRECTORY_TO_BACKUP"

  case "$LOCAL_BACKUPS_PATH" in
  /*) ;;
  *) die "LOCAL_BACKUPS_PATH must be an absolute path (starting with /), got: $LOCAL_BACKUPS_PATH" ;;
  esac

  # The destination is mirrored with 'rclone sync', so everything else in it gets deleted.
  # Accept 'remote:folder' or an absolute local path; never a remote root or a bare name
  # (rclone would treat 'gdrive' as a local folder and nothing would leave the server).
  case "$RCLONE_REMOTE_NAME" in
  /*) remote_path="$RCLONE_REMOTE_NAME" ;;
  *:*) remote_path="${RCLONE_REMOTE_NAME#*:}" ;;
  *) remote_path="" ;;
  esac
  if [ -z "${remote_path//\//}" ]; then
    die "RCLONE_REMOTE_NAME must be 'remote:folder' (e.g. gdrive:backups/my-site) or an absolute local path, got: '$RCLONE_REMOTE_NAME'.${nl}The folder is mirrored, so files in it that are not part of the backup get deleted; use a dedicated folder, never the remote root."
  fi

  bwlimit=()
  if [ -n "$RCLONE_BWLIMIT" ]; then
    bwlimit=(--bwlimit "$RCLONE_BWLIMIT")
    # Parses the value without touching any remote, so a typo fails before any work is done.
    error=$(rclone "${bwlimit[@]}" version 2>&1 >/dev/null) ||
      die "RCLONE_BWLIMIT is not a valid rclone --bwlimit value (e.g. '10M'): ${error%%$'\n'*}"
  fi

  # mysqldump reads the credentials from an option file (mode 600 via umask), so they never
  # appear on a command line, where other users of the server could see them with ps.
  # Option-file values: double-quoted, \ and " escaped, a newline written as \n.
  function cnf_value() {
    local value="${1//\\/\\\\}"
    value="${value//\"/\\\"}"
    printf '"%s"' "${value//$'\n'/\\n}"
  }
  # Removed first: '>' keeps the mode of an existing file, the umask applies only on create.
  rm -f mysqldump.cnf
  printf '[client]\nuser=%s\npassword=%s\nhost=%s\n' "$(cnf_value "$DB_USER")" "$(cnf_value "$DB_PASS")" \
    "$(cnf_value "$DB_HOST")" >mysqldump.cnf || die "Could not write $PWD/mysqldump.cnf."

  export DB_NAME
  export DIRECTORY_TO_BACKUP LOCAL_BACKUPS_PATH RCLONE_REMOTE_NAME

  # resticprofile creates a new empty repository when none exists locally, and the
  # following 'rclone sync' would then replace the backup history in the cloud with it.
  # So only allow that when the destination has no repository either (first run).
  if [ ! -f "$LOCAL_BACKUPS_PATH/config" ]; then
    log "No local repository at $LOCAL_BACKUPS_PATH, checking $RCLONE_REMOTE_NAME..."
    listing=$(rclone lsf "$RCLONE_REMOTE_NAME" --files-only --max-depth 1 2>&1)
    status=$?
    # rclone exit code 3 = directory not found, i.e. nothing there yet.
    if [ "$status" -ne 0 ] && [ "$status" -ne 3 ]; then
      die "Could not check $RCLONE_REMOTE_NAME for an existing repository (rclone exit code $status):${nl}$listing"
    fi
    if [ "$status" -eq 0 ] && grep -qx config <<<"$listing"; then
      die "The local repository $LOCAL_BACKUPS_PATH is missing, but $RCLONE_REMOTE_NAME already contains one.${nl}Not creating a new repository, because syncing it would delete the backup history there.${nl}Restore the local copy first, then run the backup again:${nl}  rclone copy \"$RCLONE_REMOTE_NAME\" \"$LOCAL_BACKUPS_PATH\""
    fi
    log "No repository found, a new one will be created."
  fi

  # Low CPU priority (nice 15) so the backup gives way to the website; restic, mysqldump and
  # rclone inherit it, and Linux derives their disk priority from it. Set per command, so
  # the shell that started this script keeps its priority.
  low_priority=()
  command -v nice >/dev/null 2>&1 && low_priority=(nice -n 15)

  failed=""
  # step <name> <description> <command...>: a failed step is reported with the end of its
  # output and makes the run fail at the end, but the following steps still run.
  function step() {
    local name="$1" description="$2" start
    shift 2
    log "$description..."
    start=$(wc -l <"$LOG_FILE")
    run "${low_priority[@]}" "$@" && return 0
    failed+=" $name"
    echo "ERROR: $description failed. Last lines of its output (full log: $PWD/$LOG_FILE):" >&2
    tail -n +"$((start + 1))" "$LOG_FILE" | tail -n 30 >&2
    return 1
  }

  # A failing database dump must not stop the files backup, and a failing backup must not
  # stop the retention policy (otherwise the repository grows until the quota is full).
  step database "Backup of 'database'" resticprofile --name database backup
  step www "Backup of 'www'" resticprofile --name www backup
  step forget "Removing old snapshots" resticprofile --name maintenance forget
  # Never mirror a damaged repository over the good copy in the cloud.
  if step check "Repository check" resticprofile --name maintenance check; then
    step upload "Upload" rclone sync "$LOCAL_BACKUPS_PATH" "$RCLONE_REMOTE_NAME" --log-level INFO "${bwlimit[@]}"
  else
    echo "ERROR: Not uploading to $RCLONE_REMOTE_NAME, so the copy there is not replaced by a damaged repository." | tee -a "$LOG_FILE" >&2
  fi
  [ -z "$failed" ] || die "Backup failed for:$failed"

  log "Backup completed successfully!"
  exit 0

}

wsb_install_command() {

  # wsb install: installs or updates restic, resticprofile and rclone into ~/bin and creates
  # the initial password-file, config.conf and profiles.d/ next to wsb. Safe to run again:
  # existing password-file and config.conf are never overwritten.
  # curl or wget, sha256sum or shasum, tar, gzip, bzip2 and unzip are checked by bashly
  # (dependencies in bashly.yml), and ~/bin is put in front of PATH by initialize.sh.
  # Every download is checked against the SHA-256 file of its release before it reaches ~/bin.

  # Strict mode for the installer only. The arguments are already parsed and nothing but
  # this command runs after it, so it does not affect the rest of wsb.
  set -euo pipefail

  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  BIN_DIR="$HOME/bin"

  fail() {
    echo "Error: $*" >&2
    exit 1
  }

  case "$(uname -m)" in
    x86_64) ARCH=amd64 ;;
    aarch64 | arm64) ARCH=arm64 ;;
    *) fail "unsupported architecture $(uname -m). Only x86_64 (amd64) and aarch64 (arm64) are supported." ;;
  esac

  mkdir -p "$BIN_DIR"
  TMP_DIR="$(mktemp -d)"
  trap 'rm -rf "$TMP_DIR"' EXIT

  # latest_version <owner/repo>: version (without the leading v) of the latest GitHub release.
  latest_version() {
    local tag
    tag=$(latest_github_tag "$1")
    [[ $tag =~ ^v[0-9]+(\.[0-9]+)+$ ]] || fail "could not get the latest $1 release from GitHub (network problem?). Try again later."
    echo "${tag#v}"
  }

  # is_current <tool> <version>: ~/bin/<tool> exists and reports that version.
  is_current() {
    local out
    out=$("$BIN_DIR/$1" version 2>/dev/null) || return 1
    out=${out%%$'\n'*}
    case " $out " in
      *" $2 "* | *" v$2 "*) return 0 ;;
    esac
    return 1
  }

  # get_verified <url> <sums url>: downloads <url> into TMP_DIR (under its own name) and checks
  # it against the checksum file at <sums url>. Exits on any failure.
  get_verified() {
    local file="$TMP_DIR/${1##*/}"
    download "$1" "$file" || fail "downloading $1 failed."
    download "$2" "$TMP_DIR/sums" || fail "downloading $2 failed."
    verify_sha256 "$file" "$TMP_DIR/sums" || fail "${1##*/} does not match $2, not installing it. Nothing in $BIN_DIR was changed."
  }

  echo
  version=$(latest_version restic/restic)
  if is_current restic "$version"; then
    echo "restic $version is already installed and up to date."
  else
    echo "Installing restic $version..."
    asset="restic_${version}_linux_$ARCH"
    base="https://github.com/restic/restic/releases/download/v$version"
    get_verified "$base/$asset.bz2" "$base/SHA256SUMS"
    bzip2 -d "$TMP_DIR/$asset.bz2"
    chmod +x "$TMP_DIR/$asset"
    mv "$TMP_DIR/$asset" "$BIN_DIR/restic"
    "$BIN_DIR/restic" version
  fi

  echo
  version=$(latest_version creativeprojects/resticprofile)
  if is_current resticprofile "$version"; then
    echo "resticprofile $version is already installed and up to date."
  else
    echo "Installing resticprofile $version..."
    asset="resticprofile_${version}_linux_$ARCH.tar.gz"
    base="https://github.com/creativeprojects/resticprofile/releases/download/v$version"
    get_verified "$base/$asset" "$base/checksums.txt"
    tar -xzf "$TMP_DIR/$asset" -C "$TMP_DIR" resticprofile
    chmod +x "$TMP_DIR/resticprofile"
    mv "$TMP_DIR/resticprofile" "$BIN_DIR/resticprofile"
    "$BIN_DIR/resticprofile" version
  fi

  echo
  # rclone does not publish its binaries as GitHub release assets; version.txt is "rclone vX.Y.Z".
  download https://downloads.rclone.org/version.txt "$TMP_DIR/rclone-version.txt" || true
  version=$(sed -n 's/^rclone v//p' "$TMP_DIR/rclone-version.txt" 2>/dev/null) || true
  [[ $version =~ ^[0-9]+(\.[0-9]+)+$ ]] || fail "could not get the latest rclone version from downloads.rclone.org (network problem?). Try again later."
  if is_current rclone "$version"; then
    echo "rclone $version is already installed and up to date."
  else
    echo "Installing rclone $version..."
    asset="rclone-v$version-linux-$ARCH"
    base="https://downloads.rclone.org/v$version"
    get_verified "$base/$asset.zip" "$base/SHA256SUMS"
    unzip -q "$TMP_DIR/$asset.zip" -d "$TMP_DIR"
    chmod +x "$TMP_DIR/$asset/rclone"
    mv "$TMP_DIR/$asset/rclone" "$BIN_DIR/rclone"
    "$BIN_DIR/rclone" version
  fi

  # shellcheck disable=SC2016 # $HOME and $PATH must expand in .bashrc, not here
  path_line='export PATH=$HOME/bin:$PATH'
  if ! grep -qxF "$path_line" ~/.bashrc 2>/dev/null; then
    echo "$path_line" >>~/.bashrc
  fi

  cd "$SCRIPT_DIR"

  echo
  if [ -s password-file ]; then
    chmod 600 password-file
    echo "Keeping existing ./password-file (it is the key to your existing backups)."
  else
    (umask 077 && resticprofile generate --random-key >"$TMP_DIR/password-file")
    if [ ! -s "$TMP_DIR/password-file" ]; then
      echo "Error: generating the repository password failed, ./password-file was not created." >&2
      exit 1
    fi
    mv "$TMP_DIR/password-file" password-file
    chmod 600 password-file
    echo "Generated secure password for the repository in ./password-file. Please keep this safe!"
  fi

  echo
  if [ -e config.conf ]; then
    chmod 600 config.conf
    echo "Keeping existing ./config.conf."
  else
    (umask 077 && cp config.conf.example config.conf)
    chmod 600 config.conf
    echo "Created example configuration in ./config.conf, please fill this with your own values"
  fi

  # Local overrides of profiles.yaml (see 'includes' there). Updates (get.sh) never touch
  # this directory.
  mkdir -p profiles.d
  chmod 700 profiles.d
  if [ ! -e profiles.d/README.txt ]; then
    # shellcheck disable=SC2016 # $DIRECTORY_TO_BACKUP is expanded by resticprofile, not here
    printf '%s\n' \
      '# Local changes to profiles.yaml. Every *.yaml file in this directory is read after' \
      '# profiles.yaml, in alphabetical order. Its values replace the ones in profiles.yaml; a list' \
      '# (like exclude) is replaced as a whole, so repeat the entries you want to keep.' \
      '# Updating wsb never touches these files.' \
      '#' \
      '# Example: save the lines below as profiles.d/local.yaml, without the leading "# ".' \
      '#' \
      '# maintenance:' \
      '#   forget:' \
      '#     keep-daily: 14' \
      '# www:' \
      '#   backup:' \
      '#     exclude:' \
      '#       - "$DIRECTORY_TO_BACKUP/cache"' \
      '#       - "$DIRECTORY_TO_BACKUP/var/tmp"' \
      >profiles.d/README.txt
    echo
    echo "Created ./profiles.d/ for local changes to profiles.yaml (see profiles.d/README.txt)."
  fi

  echo

}

wsb_update_command() {

  # wsb update: downloads get.sh of the requested (or latest) release and runs it for the
  # directory of this wsb. get.sh does the actual update, so there is one implementation of it;
  # WSB_TARBALL in the environment is passed through (tests).

  set -euo pipefail

  repo=raqso/www-serwer-backup-script
  tag="${args[--version]:-}"
  [ -n "$tag" ] || tag=$(latest_github_tag "$repo")
  if [[ ! $tag =~ ^v[0-9]+(\.[0-9]+)+$ ]]; then
    echo "Error: '${tag:-}' is not a release tag like v0.5.0 (or the latest release could not be found: network problem?)." >&2
    exit 1
  fi

  TMP_DIR="$(mktemp -d)"
  trap 'rm -rf "$TMP_DIR"' EXIT
  url="https://raw.githubusercontent.com/$repo/$tag/get.sh"
  if ! download "$url" "$TMP_DIR/get.sh"; then
    echo "Error: downloading $url failed (no such release, a release without get.sh, or a network problem)." >&2
    exit 1
  fi
  WSB_DIR="$(cd "$(dirname "$0")" && pwd)" WSB_VERSION="$tag" bash "$TMP_DIR/get.sh"

}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        wsb_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    backup)
      action="backup"
      shift
      wsb_backup_parse_requirements "$@"
      shift $#
      ;;

    install)
      action="install"
      shift
      wsb_install_parse_requirements "$@"
      shift $#
      ;;

    update)
      action="update"
      shift
      wsb_update_parse_requirements "$@"
      shift $#
      ;;

    "")
      wsb_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

